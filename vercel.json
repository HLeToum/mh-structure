{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.web3forms.com https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://cdn.jsdelivr.net; worker-src blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/mentions-legales",                        "destination": "/mentions-legales.html" },
    { "source": "/politique-confidentialite",               "destination": "/politique-confidentialite.html" },
    { "source": "/attestation-parasismique-guadeloupe",     "destination": "/attestation-parasismique-guadeloupe.html" },
    { "source": "/attestation-parasismique-tarn",           "destination": "/attestation-parasismique-tarn.html" },
    { "source": "/note-de-calcul-beton-arme",               "destination": "/note-de-calcul-beton-arme.html" },
    { "source": "/diagnostic-sismique-guadeloupe",          "destination": "/diagnostic-sismique-guadeloupe.html" },
    { "source": "/diagnostic-structurel-tarn",              "destination": "/diagnostic-structurel-tarn.html" },
    { "source": "/attestation-at2-fin-de-chantier",         "destination": "/attestation-at2-fin-de-chantier.html" },
    { "source": "/etude-parasismique-zone-5",               "destination": "/etude-parasismique-zone-5.html" },
    { "source": "/plans-coffrage-armatures",                "destination": "/plans-coffrage-armatures.html" }
  ]
}
